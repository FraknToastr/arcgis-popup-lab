// =========================================================
// 8. IFRAME SANDBOX TESTS
// =========================================================

html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>8. Iframe sandbox permissions</div>";

html += "<div class='lab5Grid'>";


// NO SCRIPT PERMISSION

html += "<div>";

html += "<div style='margin-bottom:6px;font-weight:700;'>";

html += "Sandbox without scripts";

html += "</div>";

html += "<iframe ";
html += "class='testFrame' ";
html += "sandbox='' ";
html += "src='";
html += iframeAppUri;
html += "'>";

html += "Sandbox fallback";

html += "</iframe>";

html += "</div>";


// SCRIPT PERMISSION

html += "<div>";

html += "<div style='margin-bottom:6px;font-weight:700;'>";

html += "Sandbox with allow-scripts";

html += "</div>";

html += "<iframe ";
html += "class='testFrame' ";
html += "sandbox='allow-scripts allow-forms' ";
html += "src='";
html += iframeAppUri;
html += "'>";

html += "Sandbox script fallback";

html += "</iframe>";

html += "</div>";

html += "</div>";

html += "<div style='";
html += "margin-top:8px;";
html += "font-size:11px;";
html += "color:#cbd5e1;";
html += "line-height:1.5;";
html += "'>";

html += "Expected if the sandbox attribute is retained: the first iframe remains ";
html += "at SCRIPT HAS NOT RUN; the second executes JavaScript. ";
html += "Data-URI localStorage may still be unavailable because it has an opaque origin.";

html += "</div>";

html += "</div>";


// =========================================================
// 9. EXTERNAL EMBED WITH SANDBOX PERMISSIONS
// =========================================================

html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>9. Sandboxed external web application</div>";

html += "<iframe ";

html += "src='https://www.openstreetmap.org/export/embed.html?";
html += "bbox=138.575%2C-34.945%2C138.625%2C-34.895";
html += "&amp;layer=mapnik";
html += "&amp;marker=-34.9285%2C138.6007' ";

html += "sandbox='";
html += "allow-scripts ";
html += "allow-same-origin ";
html += "allow-forms ";
html += "allow-popups";
html += "' ";

html += "loading='lazy' ";

html += "referrerpolicy='no-referrer' ";

html += "style='";
html += "display:block;";
html += "width:100%;";
html += "height:280px;";
html += "background:#e2e8f0;";
html += "border:3px solid #22c55e;";
html += "border-radius:9px;";
html += "'>";

html += "OpenStreetMap iframe fallback";

html += "</iframe>";

html += "<div style='";
html += "margin-top:8px;";
html += "font-size:11px;";
html += "color:#cbd5e1;";
html += "'>";

html += "Check whether map panning, zooming and links still work under sandbox restrictions.";

html += "</div>";

html += "</div>";


// =========================================================
// 10. PARENT DOCUMENT SCRIPT AND EVENT ATTRIBUTES
// =========================================================

html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>10. Parent popup script and event sanitisation</div>";

html += "<div class='lab5Panel'>";

html += "<div id='parentScriptStatus' class='statusBox'>";

html += "PARENT SCRIPT DID NOT RUN";

html += "</div>";


// Direct script

html += "<script>";

html += "document.getElementById('parentScriptStatus')";
html += ".textContent='PARENT SCRIPT EXECUTED';";

html += "</script>";


// Inline click handler

html += "<a ";
html += "class='lab5Link' ";
html += "href='javascript:void(0)' ";
html += "onclick=\"";
html += "document.getElementById('parentScriptStatus')";
html += ".textContent='ONCLICK EXECUTED';";
html += "return false;";
html += "\" ";
html += "style='margin-top:10px;'>";

html += "Attempt parent onclick event";

html += "</a>";


// Image error event

html += "<img ";
html += "src='https://popup-lab-5.invalid/missing-image.png' ";
html += "alt='Broken image event test' ";
html += "onerror=\"";
html += "document.getElementById('parentScriptStatus')";
html += ".textContent='IMAGE ONERROR EXECUTED';";
html += "\" ";
html += "style='";
html += "display:block;";
html += "width:100%;";
html += "min-height:40px;";
html += "margin-top:8px;";
html += "background:#334155;";
html += "border:2px dashed #f87171;";
html += "'>";

html += "<div style='";
html += "margin-top:9px;";
html += "font-size:11px;";
html += "color:#cbd5e1;";
html += "line-height:1.5;";
html += "'>";

html += "The status should remain PARENT SCRIPT DID NOT RUN before and after ";
html += "clicking the link and after the image fails.";

html += "</div>";

html += "</div>";
html += "</div>";


// =========================================================
// 11. STYLESHEET LOADING
// =========================================================

html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>11. Stylesheet integration</div>";

html += "<div class='lab5Grid'>";

html += "<div ";
html += "class='lab5Imported' ";
html += "style='";
html += "padding:18px;";
html += "background:#065f46;";
html += "border-radius:8px;";
html += "text-align:center;";
html += "font-weight:700;";
html += "'>";

html += "@import test";
html += "<br>";
html += "Purple means imported";

html += "</div>";


html += "<div ";
html += "class='lab5Linked' ";
html += "style='";
html += "padding:18px;";
html += "background:#065f46;";
html += "border-radius:8px;";
html += "text-align:center;";
html += "font-weight:700;";
html += "'>";

html += "LINK stylesheet test";
html += "<br>";
html += "Red means linked";

html += "</div>";

html += "</div>";

html += "<div style='";
html += "margin-top:8px;";
html += "font-size:11px;";
html += "color:#cbd5e1;";
html += "'>";

html += "Green means the corresponding external stylesheet mechanism was ignored or removed.";

html += "</div>";

html += "</div>";


// =========================================================
// 12. ESCAPING AND MARKUP INJECTION
// =========================================================

var markupSample = "";

markupSample += "<strong>Markup was interpreted</strong>";
markupSample += " & ";
markupSample += "<em>special characters</em>";
markupSample += " \"double quotes\" and 'single quotes'";


html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>12. HTML encoding and injected markup</div>";

html += "<div class='lab5Panel'>";

html += "<div style='margin-bottom:7px;font-weight:700;'>";

html += "Unencoded value";

html += "</div>";

html += "<div style='";
html += "padding:10px;";
html += "margin-bottom:12px;";
html += "background:#334155;";
html += "border-radius:6px;";
html += "'>";

html += markupSample;

html += "</div>";


html += "<div style='margin-bottom:7px;font-weight:700;'>";

html += "HTML-encoded value";

html += "</div>";

html += "<div style='";
html += "padding:10px;";
html += "background:#334155;";
html += "border-radius:6px;";
html += "font-family:Consolas,monospace;";
html += "word-break:break-all;";
html += "'>";

html += HtmlEncode(markupSample);

html += "</div>";

html += "<div style='";
html += "margin-top:9px;";
html += "font-size:11px;";
html += "color:#fcd34d;";
html += "line-height:1.5;";
html += "'>";

html += "Any feature value inserted into HTML should be encoded unless the value ";
html += "is intentionally trusted markup.";

html += "</div>";

html += "</div>";
html += "</div>";


// =========================================================
// 13. MALFORMED HTML RECOVERY
// =========================================================

html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>13. Malformed HTML recovery</div>";

html += "<div class='lab5Panel'>";

html += "<div style='";
html += "padding:10px;";
html += "background:#713f12;";
html += "border-radius:6px;";
html += "'>";

html += "<strong>Mismatched nesting begins ";
html += "<em>italic content";
html += "</strong>";
html += " content after mismatched closing tag";
html += "</em>";

html += "<p style='margin-bottom:0;'>";

html += "Paragraph without an explicit closing tag";

html += "<div style='";
html += "margin-top:9px;";
html += "padding:9px;";
html += "background:#065f46;";
html += "border-radius:6px;";
html += "font-weight:700;";
html += "'>";

html += "RECOVERY MARKER";

html += "</div>";

html += "</div>";

html += "<div style='";
html += "margin-top:9px;";
html += "font-size:11px;";
html += "color:#cbd5e1;";
html += "'>";

html += "If the recovery marker and later sections render normally, ";
html += "the renderer successfully repaired the malformed structure.";

html += "</div>";

html += "</div>";
html += "</div>";


// =========================================================
// 14. OBJECT AND EMBED ELEMENTS
// =========================================================

html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>14. Object and embed elements</div>";

html += "<div class='lab5Grid'>";

html += "<div>";

html += "<div style='margin-bottom:6px;font-weight:700;'>OBJECT</div>";

html += "<object ";
html += "data='";
html += dynamicFrameUri;
html += "' ";
html += "type='text/html' ";
html += "style='";
html += "display:block;";
html += "width:100%;";
html += "height:140px;";
html += "background:#e2e8f0;";
html += "border:3px solid #f59e0b;";
html += "'>";

html += "Object fallback text";

html += "</object>";

html += "</div>";


html += "<div>";

html += "<div style='margin-bottom:6px;font-weight:700;'>EMBED</div>";

html += "<embed ";
html += "src='";
html += dynamicFrameUri;
html += "' ";
html += "type='text/html' ";
html += "style='";
html += "display:block;";
html += "width:100%;";
html += "height:140px;";
html += "background:#e2e8f0;";
html += "border:3px solid #ec4899;";
html += "'>";

html += "</div>";

html += "</div>";

html += "</div>";


// =========================================================
// 15. PRINT MEDIA QUERY
// =========================================================

html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>15. Print-media styling</div>";

html += "<div class='lab5Panel'>";

html += "<div class='screenOnly' style='";
html += "padding:10px;";
html += "background:#0369a1;";
html += "border-radius:6px;";
html += "font-weight:700;";
html += "'>";

html += "SCREEN VERSION";

html += "</div>";

html += "<div class='printOnly' style='";
html += "padding:10px;";
html += "border:3px solid black;";
html += "font-weight:700;";
html += "'>";

html += "PRINT MEDIA QUERY ACTIVE";

html += "</div>";

html += "<div style='";
html += "margin-top:9px;";
html += "font-size:11px;";
html += "color:#cbd5e1;";
html += "'>";

html += "Test this only through a workflow that actually prints or captures ";
html += "the popup document. Ordinary map export may omit open popup windows.";

html += "</div>";

html += "</div>";
html += "</div>";


// =========================================================
// 16. LAB PROTOCOL
// =========================================================

html += "<div class='lab5Section'>";

html += "<div class='lab5Heading'>16. Manual test protocol</div>";

html += "<div style='";
html += "padding:12px;";
html += "background:#7f1d1d;";
html += "border:1px solid #fca5a5;";
html += "border-radius:8px;";
html += "font-size:12px;";
html += "line-height:1.65;";
html += "'>";

html += "<strong>Record these results:</strong><br>";

html += "A. Which remote image formats render and animate.<br>";
html += "B. Whether the WAV control plays the embedded tone.<br>";
html += "C. Which link protocols launch successfully.<br>";
html += "D. Whether the data-URI download creates a file.<br>";
html += "E. Whether the GET form opens a URL containing objectid.<br>";
html += "F. Whether JavaScript executes inside the unrestricted iframe.<br>";
html += "G. The exact localStorage message shown by that iframe.<br>";
html += "H. Whether the two sandboxed iframe results differ.<br>";
html += "I. Whether the sandboxed OpenStreetMap remains interactive.<br>";
html += "J. Whether parent script, onclick or onerror ever executes.<br>";
html += "K. Whether @import or LINK stylesheets apply.<br>";
html += "L. Whether OBJECT or EMBED content survives.<br>";
html += "M. Whether any link unexpectedly replaces the popup itself.";

html += "</div>";

html += "</div>";


// =========================================================
// DIAGNOSTICS
// =========================================================

html += "<div style='";
html += "margin-top:20px;";
html += "padding:11px;";
html += "background:#020617;";
html += "border:1px solid #334155;";
html += "border-radius:8px;";
html += "font-family:Consolas,monospace;";
html += "font-size:11px;";
html += "line-height:1.6;";
html += "'>";

html += "OBJECTID: ";
html += oid;
html += "<br>";

html += "Iframe application URI characters: ";
html += Text(Count(iframeAppUri));
html += "<br>";

html += "Audio URI characters: ";
html += Text(Count(audioUri));
html += "<br>";

html += "Total returned HTML characters: ";
html += Text(Count(html));

html += "</div>";


html += "</div>";


// =========================================================
// RETURN
// =========================================================

return {
    type: "text",
    text: html
};