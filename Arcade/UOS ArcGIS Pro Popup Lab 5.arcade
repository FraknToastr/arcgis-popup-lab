// ---------------------------------------------------------
// HTML ENCODING
// ---------------------------------------------------------

function HtmlEncode(value) {

    var output = Text(value);

    output = Replace(output, "&", "&amp;");
    output = Replace(output, "<", "&lt;");
    output = Replace(output, ">", "&gt;");
    output = Replace(output, '"', "&quot;");
    output = Replace(output, "'", "&#39;");

    return output;
}


