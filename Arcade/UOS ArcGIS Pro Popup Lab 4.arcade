html += "margin-bottom:13px;";
html += "background:#0891b2;";
html += "border-radius:7px;";
html += "font-weight:700;";
html += "letter-spacing:1px;";
html += "'>";

html += build;

html += "</div>";

html += "<div style='font-size:26px;font-weight:700;'>";

html += "Performance and persistence laboratory";

html += "</div>";

html += "<div style='";
html += "margin-top:4px;";
html += "color:#7dd3fc;";
html += "font-size:12px;";
html += "'>";

html += "Large DOM output, selector load, image payloads, resizing and retained state";

html += "</div>";


// ---------------------------------------------------------
// Test configuration summary
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>1. Active stress configuration</div>";

html += "<div class='lab4Panel'>";

html += "<table style='width:100%;border-collapse:collapse;'>";

html += "<tr>";
html += "<td style='padding:5px;border-bottom:1px solid #475569;'>Generated rows</td>";
html += "<td style='padding:5px;border-bottom:1px solid #475569;text-align:right;'>";
html += Text(rowCount);
html += "</td>";
html += "</tr>";

html += "<tr>";
html += "<td style='padding:5px;border-bottom:1px solid #475569;'>Generated cards</td>";
html += "<td style='padding:5px;border-bottom:1px solid #475569;text-align:right;'>";
html += Text(cardCount);
html += "</td>";
html += "</tr>";

html += "<tr>";
html += "<td style='padding:5px;border-bottom:1px solid #475569;'>Unique CSS selectors</td>";
html += "<td style='padding:5px;border-bottom:1px solid #475569;text-align:right;'>";
html += Text(selectorCount);
html += "</td>";
html += "</tr>";

html += "<tr>";
html += "<td style='padding:5px;border-bottom:1px solid #475569;'>Animated elements</td>";
html += "<td style='padding:5px;border-bottom:1px solid #475569;text-align:right;'>";
html += Text(animationCount);
html += "</td>";
html += "</tr>";

html += "<tr>";
html += "<td style='padding:5px;'>Nested DOM depth</td>";
html += "<td style='padding:5px;text-align:right;'>";
html += Text(nestingDepth);
html += "</td>";
html += "</tr>";

html += "</table>";

html += "</div>";
html += "</div>";


// ---------------------------------------------------------
// Responsive viewport and DPI
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>2. Popup width and display scaling</div>";

html += "<div class='lab4Panel'>";

html += "<span class='viewportBadge viewportSmall'>";
html += "SMALL VIEWPORT — under 450 px";
html += "</span>";

html += "<span class='viewportBadge viewportMedium'>";
html += "MEDIUM VIEWPORT — 450 to 699 px";
html += "</span>";

html += "<span class='viewportBadge viewportLarge'>";
html += "LARGE VIEWPORT — 700 px or wider";
html += "</span>";

html += "<br>";

html += "<span class='dpiBadge'>";
html += "DISPLAY RESOLUTION TEST";
html += "</span>";

html += "<div style='margin-top:10px;font-size:12px;color:#cbd5e1;'>";

html += "Resize, dock and float the popup. The viewport badge should update.";

html += "</div>";

html += "</div>";
html += "</div>";


// ---------------------------------------------------------
// Persistence controls
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>3. Form and interface-state persistence</div>";

html += "<div class='lab4Panel'>";

html += "<div style='";
html += "padding:8px;";
html += "margin-bottom:10px;";
html += "background:#334155;";
html += "border-radius:7px;";
html += "font-size:12px;";
html += "'>";

html += "Current feature OBJECTID: ";
html += "<strong>" + Text($feature.OBJECTID) + "</strong>";

html += "</div>";

html += "<div class='stateGrid'>";

html += "<input ";
html += "class='stateInput' ";
html += "type='text' ";
html += "value='CHANGE THIS TEXT' ";
html += "autocomplete='off'>";

html += "<input ";
html += "class='stateInput' ";
html += "type='number' ";
html += "value='12345'>";

html += "<input ";
html += "type='color' ";
html += "value='#22c55e' ";
html += "style='width:100%;height:38px;margin-top:7px;'>";

html += "<select class='stateInput'>";

html += "<option>Option A</option>";
html += "<option>Option B</option>";
html += "<option>Option C</option>";
html += "<option>Option D</option>";

html += "</select>";

html += "</div>";

html += "<div style='margin-top:12px;'>";

html += "<input type='checkbox' id='persistCheckbox'> ";
html += "<label for='persistCheckbox'>Change this checkbox</label>";

html += "&nbsp;&nbsp;";

html += "<input type='radio' name='persistRadio' id='persistA' checked> ";
html += "<label for='persistA'>Radio A</label>";

html += "&nbsp;&nbsp;";

html += "<input type='radio' name='persistRadio' id='persistB'> ";
html += "<label for='persistB'>Radio B</label>";

html += "</div>";

html += "<div style='margin-top:12px;'>";

html += "Range state: ";

html += "<input ";
html += "type='range' ";
html += "min='0' ";
html += "max='100' ";
html += "value='25' ";
html += "style='width:70%;'>";

html += "</div>";

html += "<details style='";
html += "margin-top:12px;";
html += "padding:9px;";
html += "background:#312e81;";
html += "border-radius:7px;";
html += "'>";

html += "<summary style='cursor:pointer;font-weight:700;'>";

html += "Expand this disclosure";

html += "</summary>";

html += "<div style='padding-top:9px;'>";

html += "Leave this section expanded before closing the popup.";

html += "</div>";

html += "</details>";

html += "<div ";
html += "class='editableRegion' ";
html += "contenteditable='true'>";

html += "Try editing this contenteditable region.";

html += "</div>";

html += "<div class='stateScroll'>";

for (var stateRow = 1; stateRow <= 15; stateRow++) {

    html += "<div>";
    html += "Persistence scroll marker " + Text(stateRow);
    html += "</div>";
}

html += "</div>";

html += "<div style='";
html += "margin-top:10px;";
html += "padding:9px;";
html += "background:#020617;";
html += "border-radius:6px;";
html += "font-size:11px;";
html += "line-height:1.5;";
html += "'>";

html += "Change every control, edit both text regions, expand Details and scroll ";
html += "the internal list to marker 10. Then test closing and reopening the popup, ";
html += "selecting another feature, returning to this feature, toggling the layer ";
html += "and reopening the project.";

html += "</div>";

html += "</div>";
html += "</div>";


// ---------------------------------------------------------
// Large generated table
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>";
html += "4. Generated table — " + Text(rowCount) + " rows";
html += "</div>";

html += "<div class='tableViewport'>";

html += "<table class='stressTable'>";

html += "<thead>";
html += "<tr>";
html += "<th>Row</th>";
html += "<th>Generated value</th>";
html += "<th>Category</th>";
html += "<th style='width:42%;'>Visual value</th>";
html += "</tr>";
html += "</thead>";

html += "<tbody>";

for (var rowIndex = 1; rowIndex <= rowCount; rowIndex++) {

    var rowValue = (rowIndex * 37) % 101;
    var categoryNumber = rowIndex % 6;

    var category = When(
        categoryNumber == 0, "Alpha",
        categoryNumber == 1, "Beta",
        categoryNumber == 2, "Gamma",
        categoryNumber == 3, "Delta",
        categoryNumber == 4, "Epsilon",
        "Zeta"
    );

    html += "<tr>";

    html += "<td>";
    html += Text(rowIndex);
    html += "</td>";

    html += "<td>";
    html += Text(rowValue);
    html += "</td>";

    html += "<td>";
    html += category;
    html += "</td>";

    html += "<td>";

    html += "<div class='rowBar' style='";
    html += "width:" + Text(rowValue) + "%;";
    html += "'></div>";

    html += "</td>";

    html += "</tr>";
}

html += "</tbody>";
html += "</table>";
html += "</div>";
html += "</div>";


// ---------------------------------------------------------
// Large card wall
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>";
html += "5. Card wall — " + Text(cardCount) + " elements";
html += "</div>";

html += "<div class='cardWall'>";

for (var cardIndex = 1; cardIndex <= cardCount; cardIndex++) {

    var hue = (cardIndex * 47) % 360;
    var uniqueClass = 1 + ((cardIndex - 1) % selectorCount);

    html += "<div class='stressCard stressCard";
    html += Text(uniqueClass);
    html += "' style='";

    html += "background:";
    html += "linear-gradient(135deg,";
    html += "hsl(" + Text(hue) + ",75%,45%),";
    html += "hsl(" + Text((hue + 55) % 360) + ",80%,32%)";
    html += ");";

    html += "'>";

    html += "Card<br>" + Text(cardIndex);

    html += "</div>";
}

html += "</div>";
html += "</div>";


// ---------------------------------------------------------
// Animation wall
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>";
html += "6. Simultaneous animation load — ";
html += Text(animationCount);
html += " elements";
html += "</div>";

html += "<div class='animationWall'>";

for (var animationIndex = 1;
     animationIndex <= animationCount;
     animationIndex++) {

    var animationHue = (animationIndex * 61) % 360;
    var animationDelay = (animationIndex % 20) * 0.07;
    var animationDuration = 0.8 + ((animationIndex % 13) * 0.11);

    html += "<div class='animationTile' style='";

    html += "background:hsl(";
    html += Text(animationHue);
    html += ",80%,55%);";

    html += "animation-delay:-";
    html += Text(animationDelay);
    html += "s;";

    html += "animation-duration:";
    html += Text(animationDuration);
    html += "s;";

    html += "'></div>";
}

html += "</div>";

html += "<div style='";
html += "margin-top:8px;";
html += "font-size:11px;";
html += "color:#cbd5e1;";
html += "'>";

html += "Observe animation smoothness while scrolling the table and card wall.";

html += "</div>";

html += "</div>";


// ---------------------------------------------------------
// Data URI payloads
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>7. Generated data-URI image payloads</div>";

html += "<div class='lab4Panel'>";

html += "<div style='font-weight:700;'>Small data URI</div>";

html += "<div style='font-size:11px;color:#94a3b8;'>";

html += Text(Count(smallSvg));
html += " URI characters, ";
html += Text(smallSvgShapes);
html += " generated shapes";

html += "</div>";

html += "<img class='dataImage' src='";
html += smallSvg;
html += "'>";


html += "<div style='margin-top:14px;font-weight:700;'>";

html += "Medium data URI";

html += "</div>";

html += "<div style='font-size:11px;color:#94a3b8;'>";

html += Text(Count(mediumSvg));
html += " URI characters, ";
html += Text(mediumSvgShapes);
html += " generated shapes";

html += "</div>";

html += "<img class='dataImage' src='";
html += mediumSvg;
html += "'>";


html += "<div style='margin-top:14px;font-weight:700;'>";

html += "Large data URI";

html += "</div>";

html += "<div style='font-size:11px;color:#94a3b8;'>";

html += Text(Count(largeSvg));
html += " URI characters, ";
html += Text(largeSvgShapes);
html += " generated shapes";

html += "</div>";

html += "<img class='dataImage' src='";
html += largeSvg;
html += "'>";

html += "</div>";
html += "</div>";


// ---------------------------------------------------------
// Nested DOM
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>";
html += "8. Nested DOM depth — ";
html += Text(nestingDepth);
html += " levels";
html += "</div>";

html += "<div class='nestViewport'>";

for (var depthOpen = 1; depthOpen <= nestingDepth; depthOpen++) {

    html += "<div class='nestLayer'>";
}

html += "<div style='";
html += "padding:12px;";
html += "background:#f59e0b;";
html += "color:#111827;";
html += "border-radius:6px;";
html += "font-weight:700;";
html += "text-align:center;";
html += "'>";

html += "DEEPEST LEVEL REACHED";

html += "</div>";

for (var depthClose = nestingDepth; depthClose >= 1; depthClose--) {

    html += "</div>";
}

html += "</div>";
html += "</div>";


// ---------------------------------------------------------
// Pixel scaling
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>9. Pixel grid and thin-line rendering</div>";

html += "<div class='lab4Panel'>";

html += "<div class='pixelGrid'></div>";

html += "<div class='thinLines'>";

html += "<div class='thinLine1'></div>";
html += "<div class='thinLine2'></div>";
html += "<div class='thinLine3'></div>";
html += "<div class='thinLine4'></div>";

html += "</div>";

html += "<div style='";
html += "margin-top:10px;";
html += "font-size:11px;";
html += "color:#cbd5e1;";
html += "'>";

html += "The four horizontal samples are 1, 2, 3 and 4 CSS pixels thick.";

html += "</div>";

html += "</div>";
html += "</div>";


// =========================================================
// APPROXIMATE BUILD DIAGNOSTICS
// =========================================================

var buildElapsed = DateDiff(Now(), buildStarted, "milliseconds");
var htmlCharactersBeforeDiagnostics = Count(html);


html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>10. Expression diagnostics</div>";

html += "<div style='";
html += "padding:12px;";
html += "background:#020617;";
html += "border:1px solid #334155;";
html += "border-radius:8px;";
html += "font-family:Consolas,monospace;";
html += "font-size:12px;";
html += "line-height:1.7;";
html += "'>";

html += "Approximate Arcade construction time: ";
html += "<strong>";
html += Text(buildElapsed);
html += " ms</strong><br>";

html += "HTML characters before diagnostics: ";
html += "<strong>";
html += Text(htmlCharactersBeforeDiagnostics);
html += "</strong><br>";

html += "CSS characters: ";
html += "<strong>";
html += Text(Count(css));
html += "</strong><br>";

html += "Large SVG data-URI characters: ";
html += "<strong>";
html += Text(Count(largeSvg));
html += "</strong><br>";

html += "Feature OBJECTID: ";
html += "<strong>";
html += Text($feature.OBJECTID);
html += "</strong>";

html += "</div>";

html += "<div style='";
html += "margin-top:10px;";
html += "padding:10px;";
html += "background:#312e81;";
html += "border-radius:7px;";
html += "font-size:11px;";
html += "line-height:1.5;";
html += "'>";

html += "The Arcade timing value measures expression-side construction only. ";
html += "It does not include the time ArcGIS Pro takes to sanitise, lay out, paint ";
html += "and animate the returned HTML.";

html += "</div>";

html += "</div>";


// ---------------------------------------------------------
// Manual test protocol
// ---------------------------------------------------------

html += "<div class='lab4Section'>";

html += "<div class='lab4Heading'>11. Manual persistence protocol</div>";

html += "<div style='";
html += "padding:12px;";
html += "background:#7f1d1d;";
html += "border:1px solid #fca5a5;";
html += "border-radius:8px;";
html += "font-size:12px;";
html += "line-height:1.6;";
html += "'>";

html += "<strong>Test in this order:</strong><br>";

html += "A. Change every control and scroll each internal region.<br>";
html += "B. Close and reopen this same feature popup.<br>";
html += "C. Open another feature and return to this feature.<br>";
html += "D. Toggle the layer off and on.<br>";
html += "E. Dock, float and resize the popup.<br>";
html += "F. Save, close and reopen the ArcGIS Pro project.<br>";
html += "G. Record which form values, disclosure states and scroll positions survive.";

html += "</div>";

html += "</div>";


html += "</div>";


// =========================================================
// RETURN POPUP ELEMENT
// =========================================================

return {
    type: "text",
    text: html
};