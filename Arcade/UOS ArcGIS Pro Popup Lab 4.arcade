// =========================================================
// POPUP LAB 4
// Performance, scale, resizing and state persistence
// =========================================================

var build = "POPUP LAB — BUILD 004";


// ---------------------------------------------------------
// STRESS CONFIGURATION
// ---------------------------------------------------------

var rowCount = 300;
var cardCount = 120;
var selectorCount = 160;
var animationCount = 48;
var nestingDepth = 32;

var smallSvgShapes = 30;
var mediumSvgShapes = 120;
var largeSvgShapes = 260;


// ---------------------------------------------------------
// START APPROXIMATE ARCADE TIMER
// ---------------------------------------------------------

var buildStarted = Now();


// =========================================================
// DATA-URI SVG GENERATOR
// =========================================================

function BuildSvgUri(shapeCount) {

    var colours = [
        "%230ea5e9",
        "%238b5cf6",
        "%2322c55e",
        "%23f59e0b",
        "%23ef4444",
        "%23ec4899"
    ];

    var uri = "";

    uri += "data:image/svg+xml,";
    uri += "%3Csvg%20xmlns=%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22";
    uri += "%20viewBox=%220%200%20520%20180%22%3E";

    uri += "%3Cdefs%3E";
    uri += "%3ClinearGradient%20id=%22bg%22%20x1=%220%22%20x2=%221%22%3E";
    uri += "%3Cstop%20stop-color=%22%230f172a%22%2F%3E";
    uri += "%3Cstop%20offset=%221%22%20stop-color=%22%231e293b%22%2F%3E";
    uri += "%3C%2FlinearGradient%3E";
    uri += "%3C%2Fdefs%3E";

    uri += "%3Crect%20width=%22520%22%20height=%22180%22";
    uri += "%20rx=%2218%22%20fill=%22url(%23bg)%22%2F%3E";

    for (var i = 0; i < shapeCount; i++) {

        var cx = 12 + ((i * 37) % 496);
        var cy = 12 + ((i * 53) % 156);
        var radius = 2 + (i % 8);
        var colour = colours[i % Count(colours)];
        var opacity = 35 + ((i * 11) % 65);

        uri += "%3Ccircle";
        uri += "%20cx=%22" + Text(cx) + "%22";
        uri += "%20cy=%22" + Text(cy) + "%22";
        uri += "%20r=%22" + Text(radius) + "%22";
        uri += "%20fill=%22" + colour + "%22";
        uri += "%20fill-opacity=%220." + Text(opacity) + "%22";
        uri += "%2F%3E";
    }

    uri += "%3Ctext";
    uri += "%20x=%2220%22";
    uri += "%20y=%22160%22";
    uri += "%20font-family=%22Arial%22";
    uri += "%20font-size=%2218%22";
    uri += "%20font-weight=%22700%22";
    uri += "%20fill=%22white%22%3E";

    uri += Text(shapeCount) + "%20GENERATED%20SVG%20SHAPES";

    uri += "%3C%2Ftext%3E";
    uri += "%3C%2Fsvg%3E";

    return uri;
}


var smallSvg = BuildSvgUri(smallSvgShapes);
var mediumSvg = BuildSvgUri(mediumSvgShapes);
var largeSvg = BuildSvgUri(largeSvgShapes);


// =========================================================
// CSS CONSTRUCTION
// =========================================================

var css = "";

css += "<style>";

css += ".lab4Root,.lab4Root *{box-sizing:border-box;}";
css += ".lab4Root{container-type:inline-size;}";

css += ".lab4Section{";
css += "margin-top:20px;";
css += "}";

css += ".lab4Heading{";
css += "margin-bottom:8px;";
css += "font-size:16px;";
css += "font-weight:700;";
css += "}";

css += ".lab4Panel{";
css += "padding:12px;";
css += "background:#1f2937;";
css += "border:1px solid #475569;";
css += "border-radius:9px;";
css += "}";


// ---------------------------------------------------------
// Responsive and DPI tests
// ---------------------------------------------------------

css += ".viewportBadge{";
css += "display:none;";
css += "padding:7px 10px;";
css += "border-radius:6px;";
css += "font-weight:700;";
css += "}";

css += "@media(max-width:449px){";
css += ".viewportSmall{display:inline-block;background:#be123c;}";
css += "}";

css += "@media(min-width:450px) and (max-width:699px){";
css += ".viewportMedium{display:inline-block;background:#d97706;}";
css += "}";

css += "@media(min-width:700px){";
css += ".viewportLarge{display:inline-block;background:#15803d;}";
css += "}";

css += ".dpiBadge{";
css += "display:inline-block;";
css += "padding:7px 10px;";
css += "margin-top:8px;";
css += "background:#475569;";
css += "border-radius:6px;";
css += "font-weight:700;";
css += "}";

css += "@media(min-resolution:1.5dppx){";
css += ".dpiBadge{background:#7c3aed;}";
css += ".dpiBadge:after{content:' — HIGH DPI QUERY ACTIVE';}";
css += "}";


// ---------------------------------------------------------
// State-persistence controls
// ---------------------------------------------------------

css += ".stateInput{";
css += "display:block;";
css += "width:100%;";
css += "padding:8px;";
css += "margin-top:7px;";
css += "border:2px solid #60a5fa;";
css += "border-radius:6px;";
css += "}";

css += ".stateGrid{";
css += "display:grid;";
css += "grid-template-columns:repeat(2,minmax(0,1fr));";
css += "gap:8px;";
css += "}";

css += ".stateScroll{";
css += "height:120px;";
css += "overflow:auto;";
css += "margin-top:10px;";
css += "background:#e2e8f0;";
css += "color:#111827;";
css += "border-radius:7px;";
css += "}";

css += ".stateScroll div{";
css += "padding:9px;";
css += "border-bottom:1px solid #94a3b8;";
css += "}";

css += ".editableRegion{";
css += "min-height:60px;";
css += "padding:10px;";
css += "margin-top:8px;";
css += "background:#ffffff;";
css += "color:#111827;";
css += "border:3px dashed #f59e0b;";
css += "border-radius:7px;";
css += "}";


// ---------------------------------------------------------
// Large table
// ---------------------------------------------------------

css += ".tableViewport{";
css += "height:350px;";
css += "overflow:auto;";
css += "border:2px solid #38bdf8;";
css += "border-radius:8px;";
css += "background:#ffffff;";
css += "}";

css += ".stressTable{";
css += "width:100%;";
css += "border-collapse:collapse;";
css += "color:#111827;";
css += "font-size:12px;";
css += "}";

css += ".stressTable th{";
css += "position:sticky;";
css += "top:0;";
css += "z-index:4;";
css += "padding:8px;";
css += "background:#0369a1;";
css += "color:white;";
css += "border:1px solid #075985;";
css += "text-align:left;";
css += "}";

css += ".stressTable td{";
css += "padding:6px 8px;";
css += "border:1px solid #cbd5e1;";
css += "}";

css += ".stressTable tr:nth-child(even){";
css += "background:#f1f5f9;";
css += "}";

css += ".rowBar{";
css += "height:9px;";
css += "background:linear-gradient(90deg,#06b6d4,#8b5cf6);";
css += "border-radius:5px;";
css += "}";


// ---------------------------------------------------------
// Card wall
// ---------------------------------------------------------

css += ".cardWall{";
css += "display:grid;";
css += "grid-template-columns:repeat(auto-fit,minmax(90px,1fr));";
css += "gap:7px;";
css += "height:390px;";
css += "overflow:auto;";
css += "padding:8px;";
css += "background:#020617;";
css += "border:2px solid #8b5cf6;";
css += "border-radius:9px;";
css += "}";

css += ".stressCard{";
css += "min-height:72px;";
css += "display:flex;";
css += "align-items:center;";
css += "justify-content:center;";
css += "padding:7px;";
css += "border-radius:8px;";
css += "text-align:center;";
css += "font-weight:700;";
css += "transition:all .18s ease;";
css += "}";


// Generate a large number of unique selectors.

for (var selectorIndex = 1; selectorIndex <= selectorCount; selectorIndex++) {

    var moveX = (selectorIndex % 7) - 3;
    var moveY = (selectorIndex % 5) - 2;
    var rotateValue = (selectorIndex % 9) - 4;

    css += ".stressCard" + Text(selectorIndex) + ":hover{";

    css += "transform:";
    css += "translate(" + Text(moveX) + "px," + Text(moveY) + "px)";
    css += " rotate(" + Text(rotateValue) + "deg)";
    css += " scale(1.08);";

    css += "filter:brightness(1.25);";
    css += "box-shadow:0 8px 20px rgba(0,0,0,.5);";

    css += "}";
}


// ---------------------------------------------------------
// Animation wall
// ---------------------------------------------------------

css += "@keyframes lab4Pulse{";
css += "0%{transform:scale(.75) rotate(-4deg);opacity:.35;}";
css += "50%{transform:scale(1.04) rotate(2deg);opacity:1;}";
css += "100%{transform:scale(.82) rotate(5deg);opacity:.5;}";
css += "}";

css += ".animationWall{";
css += "display:grid;";
css += "grid-template-columns:repeat(auto-fit,minmax(42px,1fr));";
css += "gap:6px;";
css += "padding:10px;";
css += "background:#020617;";
css += "border:2px solid #ec4899;";
css += "border-radius:9px;";
css += "}";

css += ".animationTile{";
css += "aspect-ratio:1;";
css += "border-radius:8px;";
css += "animation-name:lab4Pulse;";
css += "animation-duration:1.5s;";
css += "animation-iteration-count:infinite;";
css += "animation-direction:alternate;";
css += "animation-timing-function:ease-in-out;";
css += "}";


// ---------------------------------------------------------
// Data image tests
// ---------------------------------------------------------

css += ".dataImage{";
css += "display:block;";
css += "width:100%;";
css += "min-height:100px;";
css += "margin-top:8px;";
css += "background:#e2e8f0;";
css += "border:2px solid #14b8a6;";
css += "border-radius:9px;";
css += "}";


// ---------------------------------------------------------
// Nested DOM
// ---------------------------------------------------------

css += ".nestViewport{";
css += "height:240px;";
css += "overflow:auto;";
css += "padding:8px;";
css += "background:#020617;";
css += "border:2px solid #f59e0b;";
css += "border-radius:9px;";
css += "}";

css += ".nestLayer{";
css += "padding:5px;";
css += "border:1px solid rgba(255,255,255,.22);";
css += "border-radius:5px;";
css += "background:rgba(59,130,246,.025);";
css += "}";


// ---------------------------------------------------------
// One-pixel and scaling test
// ---------------------------------------------------------

css += ".pixelGrid{";
css += "height:100px;";
css += "background-image:";
css += "linear-gradient(90deg,rgba(255,255,255,.28) 1px,transparent 1px),";
css += "linear-gradient(rgba(255,255,255,.28) 1px,transparent 1px);";
css += "background-size:10px 10px;";
css += "background-color:#0f172a;";
css += "border:1px solid #ffffff;";
css += "}";

css += ".thinLines{";
css += "display:grid;";
css += "grid-template-columns:repeat(4,1fr);";
css += "gap:8px;";
css += "margin-top:10px;";
css += "}";

css += ".thinLine1{border-top:1px solid white;}";
css += ".thinLine2{border-top:2px solid white;}";
css += ".thinLine3{border-top:3px solid white;}";
css += ".thinLine4{border-top:4px solid white;}";

css += "</style>";


// =========================================================
// HTML CONSTRUCTION
// =========================================================

var html = css;

html += "<div class='lab4Root' style='";
html += "width:100%;";
html += "padding:14px;";
html += "background:#111827;";
html += "color:#ffffff;";
html += "border-radius:14px;";
html += "font-family:Arial,sans-serif;";
html += "'>";


// ---------------------------------------------------------
// Header
// ---------------------------------------------------------

html += "<div style='";
