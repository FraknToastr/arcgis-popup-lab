var html = "";

html += "<div style='padding:14px;background:#111827;color:#ffffff;border-radius:12px;'>";

html += "<div style='font-size:11px;letter-spacing:2px;text-transform:uppercase;";
html += "color:#93c5fd;margin-bottom:5px;'>ArcGIS Pro Popup Lab</div>";

html += "<div style='font-size:23px;font-weight:700;line-height:1.1;";
html += "margin-bottom:12px;'>HTML and CSS capability test</div>";


// ---------------------------------------------------------
// Standard box-model properties
// ---------------------------------------------------------

html += "<div style='padding:10px;margin-bottom:8px;";
html += "background:#1f2937;border:2px solid #60a5fa;";
html += "border-radius:10px;'>";

html += "<strong>Box model</strong><br>";
html += "<span style='font-size:12px;color:#d1d5db;'>";
html += "Padding, margin, border, background and border radius.";
html += "</span></div>";


// ---------------------------------------------------------
// Flexbox test
// ---------------------------------------------------------

html += "<div style='display:flex;gap:6px;margin-bottom:8px;'>";

html += "<div style='flex:1;padding:8px;text-align:center;";
html += "background:#065f46;border-radius:7px;'>Flex A</div>";

html += "<div style='flex:1;padding:8px;text-align:center;";
html += "background:#047857;border-radius:7px;'>Flex B</div>";

html += "<div style='flex:1;padding:8px;text-align:center;";
html += "background:#059669;border-radius:7px;'>Flex C</div>";

html += "</div>";


// ---------------------------------------------------------
// CSS grid test
// ---------------------------------------------------------

html += "<div style='display:grid;";
html += "grid-template-columns:repeat(2,minmax(0,1fr));";
html += "gap:6px;margin-bottom:8px;'>";

html += "<div style='padding:8px;background:#7c3aed;'>Grid 1</div>";
html += "<div style='padding:8px;background:#6d28d9;'>Grid 2</div>";
html += "<div style='padding:8px;background:#5b21b6;'>Grid 3</div>";
html += "<div style='padding:8px;background:#4c1d95;'>Grid 4</div>";

html += "</div>";


// ---------------------------------------------------------
// Gradient, shadow and transform tests
// ---------------------------------------------------------

html += "<div style='padding:12px;margin-bottom:8px;";
html += "background:linear-gradient(135deg,#2563eb,#9333ea);";
html += "box-shadow:0 5px 14px rgba(0,0,0,0.35);";
html += "border-radius:10px;'>";

html += "<strong>Gradient and shadow</strong>";
html += "</div>";

html += "<div style='padding:9px;margin:10px 4px;";
html += "background:#f59e0b;color:#111827;";
html += "transform:rotate(-2deg);border-radius:5px;'>";

html += "Transform: rotate(-2deg)";
html += "</div>";


// ---------------------------------------------------------
// Table test
// ---------------------------------------------------------

html += "<table style='width:100%;border-collapse:collapse;";
html += "margin-top:12px;background:#ffffff;color:#111827;'>";

html += "<tr>";
html += "<th style='padding:7px;border:1px solid #9ca3af;text-align:left;'>Test</th>";
html += "<th style='padding:7px;border:1px solid #9ca3af;text-align:left;'>Expected</th>";
html += "</tr>";

html += "<tr>";
html += "<td style='padding:7px;border:1px solid #d1d5db;'>Inline styles</td>";
html += "<td style='padding:7px;border:1px solid #d1d5db;'>Supported</td>";
html += "</tr>";

html += "<tr>";
html += "<td style='padding:7px;border:1px solid #d1d5db;'>Arcade values</td>";
html += "<td style='padding:7px;border:1px solid #d1d5db;'>";
html += Text($feature.FID);
html += "</td>";
html += "</tr>";

html += "</table>";


// ---------------------------------------------------------
// Image and hyperlink tests
// Replace the URLs with controlled test resources.
// ---------------------------------------------------------

html += "<div style='margin-top:12px;padding-top:10px;";
html += "border-top:1px solid #4b5563;'>";

html += "<a href='https://www.esri.com' ";
html += "style='color:#93c5fd;text-decoration:none;font-weight:bold;'>";
html += "External hyperlink test";
html += "</a>";

html += "</div>";


// ---------------------------------------------------------
// Deliberately unsupported elements
// These should be removed, escaped or rendered inert.
// ---------------------------------------------------------

html += "<style>.popup-test{color:red;}</style>";
html += "<script>document.body.innerHTML='SCRIPT EXECUTED';</script>";
html += "<iframe src='https://www.esri.com' width='100%' height='100'></iframe>";
html += "<button>Button test</button>";
html += "<input value='Input test'>";

html += "</div>";

return {
    type: "text",
    text: html
};