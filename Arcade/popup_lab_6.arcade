var APP_URL = "https://YOUR-GITHUB-USER.github.io/YOUR-REPOSITORY/";

var oid = Text($feature.OBJECTID);
var appSource = APP_URL + "?oid=" + oid + "&layer=Popup%20Lab%20Layer&source=ArcGIS-Pro&build=006";

var html = "";

html += "<div style='width:100%;padding:10px;background:#111827;color:#ffffff;border-radius:12px;font-family:Arial,sans-serif;'>";
html += "<div style='padding:8px 10px;margin-bottom:8px;background:#0e7490;border-radius:7px;font-weight:bold;letter-spacing:1px;'>";
html += "POPUP LAB - BUILD 006";
html += "</div>";
html += "<iframe src='" + appSource + "' style='display:block;box-sizing:border-box;width:100%;height:1120px;background:#0f172a;border:3px solid #38bdf8;border-radius:10px;'>";
html += "Hosted Popup Lab 6 application";
html += "</iframe>";
html += "<div style='margin-top:8px;font-size:11px;color:#cbd5e1;overflow-wrap:anywhere;'>";
html += "Hosted URL: " + APP_URL;
html += "</div>";
html += "</div>";

return {
    type: "text",
    text: html
};
