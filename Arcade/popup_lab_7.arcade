// Popup Lab 7 v1.1 — robust Object ID detection for ArcGIS Pro 3.5.3

var APP_URL = "https://YOUR-GITHUB-USER.github.io/YOUR-REPOSITORY/";
var CLIENT_ID = "YOUR_CLIENT_ID";
var PORTAL_URL = "https://www.arcgis.com";
var SERVICE_URL = "https://YOUR-FEATURE-SERVICE/FeatureServer/0";

// Detect the real Object ID field instead of assuming it is named OBJECTID.
var featureSchema = Schema($feature);
var oidField = featureSchema.objectIdField;
var oidValue = null;

if (!IsEmpty(oidField) && HasValue($feature, oidField)) {
    oidValue = $feature[oidField];
} else if (HasValue($feature, "OBJECTID")) {
    oidField = "OBJECTID";
    oidValue = $feature["OBJECTID"];
} else if (HasValue($feature, "FID")) {
    oidField = "FID";
    oidValue = $feature["FID"];
}

var html = "";

if (IsEmpty(oidValue)) {
    html += "<div style='padding:14px;background:#7f1d1d;color:white;border:2px solid #f87171;border-radius:10px;font-family:Arial,sans-serif;'>";
    html += "<strong>POPUP LAB 7 — OBJECT ID NOT FOUND</strong><br><br>";
    html += "Detected Object ID field: <strong>" + Text(oidField) + "</strong><br>";
    html += "The popup layer must expose its Object ID field to Arcade.";
    html += "</div>";

    return {
        type: "text",
        text: html
    };
}

var queryParameters = {
    oid: Text(oidValue),
    oidField: Text(oidField),
    clientId: CLIENT_ID,
    portal: PORTAL_URL,
    service: SERVICE_URL,
    source: "ArcGIS-Pro",
    build: "0071"
};

var appSource = APP_URL + "?" + UrlEncode(queryParameters);

html += "<div style='width:100%;padding:10px;background:#111827;color:#ffffff;border-radius:12px;font-family:Arial,sans-serif;'>";
html += "<div style='padding:8px 10px;margin-bottom:8px;background:#15803d;border-radius:7px;font-weight:bold;letter-spacing:1px;'>";
html += "POPUP LAB — BUILD 007.1";
html += "</div>";
html += "<div style='padding:7px 9px;margin-bottom:8px;background:#1f2937;border-radius:6px;font-size:11px;'>";
html += "ArcGIS Pro supplied <strong>" + Text(oidField) + " = " + Text(oidValue) + "</strong>";
html += "</div>";
html += "<iframe src='" + appSource + "' style='display:block;box-sizing:border-box;width:100%;height:1450px;background:#0f172a;border:3px solid #22c55e;border-radius:10px;'>";
html += "Hosted Popup Lab 7 application";
html += "</iframe>";
html += "<div style='margin-top:8px;font-size:11px;color:#cbd5e1;overflow-wrap:anywhere;'>";
html += "OAuth callback: " + APP_URL + "oauth-callback.html";
html += "</div>";
html += "</div>";

return {
    type: "text",
    text: html
};
