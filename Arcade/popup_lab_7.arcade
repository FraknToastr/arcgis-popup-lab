var APP_URL = "https://frakntoastr.github.io/arcgis-popup-lab-6/";
var CLIENT_ID = "2i8ErWnjyQES93El";
var PORTAL_URL = "https://www.arcgis.com";
var SERVICE_URL = "https://services.arcgis.com/BzylpWnjWP0tW4nL/arcgis/rest/services/City_Plan_Shape/FeatureServer/0";

var oid = Text($feature.FID);
var appSource = APP_URL + "?oid=" + oid + "&clientId=" + CLIENT_ID + "&portal=" + PORTAL_URL + "&service=" + SERVICE_URL + "&source=ArcGIS-Pro&build=007";

var html = "";
html += "<div style='width:100%;padding:10px;background:#111827;color:#ffffff;border-radius:12px;font-family:Arial,sans-serif;'>";
html += "<div style='padding:8px 10px;margin-bottom:8px;background:#15803d;border-radius:7px;font-weight:bold;letter-spacing:1px;'>";
html += "POPUP LAB - BUILD 007";
html += "</div>";
html += "<iframe src='" + appSource + "' style='display:block;box-sizing:border-box;width:100%;height:1450px;background:#0f172a;border:3px solid #22c55e;border-radius:10px;'>";
html += "Hosted Popup Lab 7 application";
html += "</iframe>";
html += "<div style='margin-top:8px;font-size:11px;color:#cbd5e1;overflow-wrap:anywhere;'>";
html += "OAuth callback: " + APP_URL + "oauth-callback.html";
html += "</div>";
html += "</div>";

return {
    type: "text",
    text: html
};
